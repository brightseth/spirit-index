{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritindex.org/schemas/durability-passport-platform-v1.1.json",
  "title": "Durability Passport v1.1 (platform)",
  "description": "The six passport fields answered for a platform where agents are born and run, from the platform's own documentation. No scores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "operator",
    "website",
    "spec_version",
    "fields"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "const": "platform"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "pattern": "^https://"
    },
    "spec_version": {
      "const": "1.1"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_anchor",
        "memory_custody",
        "persistence_ops",
        "economic_rails",
        "governance",
        "recovery"
      ],
      "properties": {
        "identity_anchor": {
          "$ref": "#/$defs/field"
        },
        "memory_custody": {
          "$ref": "#/$defs/field"
        },
        "persistence_ops": {
          "$ref": "#/$defs/field"
        },
        "economic_rails": {
          "$ref": "#/$defs/field"
        },
        "governance": {
          "$ref": "#/$defs/field"
        },
        "recovery": {
          "$ref": "#/$defs/field"
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidence",
        "checked"
      ],
      "properties": {
        "status": {
          "enum": [
            "attested",
            "stale",
            "IE"
          ],
          "description": "attested: public evidence answers the field's question and is current. stale: the newest public evidence is more than 90 days old. IE: no public evidence."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Two or three plain sentences. For IE, one line on what evidence would settle it."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "url"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "checked": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date the evidence was last read."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "IE"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
