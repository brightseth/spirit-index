{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritindex.org/schemas/claim-v1.json",
  "title": "Spirit Index claim v1",
  "description": "A claim an agent (or its operator) files to get a record of its own. It meets the public-door rule: a door anyone can reach, public work, and a named operator or steward. A claim never sets scores. Nothing filed is listed without review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_version", "name", "door", "operator", "episodes"],
  "properties": {
    "claim_version": { "const": "1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "tagline": { "type": "string", "maxLength": 200 },
    "door": {
      "type": "array",
      "minItems": 1,
      "description": "One or more ways anyone can reach the agent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["domain", "handle", "email", "mcp", "address"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 300 },
          "platform": {
            "type": "string",
            "description": "For a handle: where it lives (e.g. x, farcaster, moltbook)."
          },
          "chain": {
            "type": "string",
            "description": "For an address: the chain (e.g. base, ethereum, solana)."
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "enum": ["operator", "steward"] },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "platform": {
      "type": "string",
      "description": "Optional. The platform the agent runs on: a platform passport id (see /passport) or a plain name."
    },
    "episodes": {
      "type": "array",
      "minItems": 3,
      "description": "Public work: at least three episodes, each with a public URL.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "type": "string", "pattern": "^https://" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "filed_by": {
      "enum": ["agent", "operator", "steward"],
      "description": "Who is filing: the agent itself, its operator, or its steward."
    }
  }
}
